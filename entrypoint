#!/bin/bash
set -e

# ---------------------------------------------------------------------------
# Pi agent dir overlay
#
# The host's ~/.pi is mounted read-write, but we don't want the sandbox to
# read the user's settings.json (which may reference packages not installed
# in the container image) or to pollute the user's extensions/ directory.
#
# We build a shadow agent dir at ~/.pi-sandbox/pi-agent/ that:
#   - Has its own settings.json with the packages list cleared, so pi
#     doesn't try to install the user's host packages inside the container
#   - Has its own extensions/ dir where the entrypoint writes sandbox
#     extension symlinks (instead of writing into the host's extensions/)
#   - Symlinks everything else (via a catchall glob) back to the real
#     ~/.pi/agent/ so the agent can read credentials, history, skills,
#     context files, and binaries, and so new sessions written by the
#     agent persist to the host
#
# PI_CODING_AGENT_DIR points pi at the shadow dir instead of ~/.pi/agent/.
# ---------------------------------------------------------------------------

HOST_AGENT_DIR="$HOME/.pi/agent"
SHADOW_AGENT_DIR="$HOME/.pi-sandbox/pi-agent"

mkdir -p "$SHADOW_AGENT_DIR"

# settings.json: copy from host but strip the packages list so pi doesn't
# try to install host packages (pi-web-access, etc.) inside the container.
HOST_SETTINGS="$HOST_AGENT_DIR/settings.json"
SHADOW_SETTINGS="$SHADOW_AGENT_DIR/settings.json"
if [ -f "$HOST_SETTINGS" ]; then
    # Remove the packages key using python (available via pyenv).
    python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    s = json.load(f)
s.pop('packages', None)
print(json.dumps(s, indent=2))
" "$HOST_SETTINGS" > "$SHADOW_SETTINGS"
else
    echo '{}' > "$SHADOW_SETTINGS"
fi

# Symlink everything from the real agent dir into the shadow dir as a
# catchall, so pi can read credentials, session history, skills, binaries,
# context files, etc., and so new sessions written during this run persist
# to the host filesystem.
#
# Then override specific entries that need special handling:
#   - settings.json: copied with packages stripped (done above)
#   - extensions/:  real writable dir (not a symlink to host)
#   - skills/:      merged with sandbox source skills when --self-modify
for entry in "$HOST_AGENT_DIR"/*; do
    [ -e "$entry" ] || continue
    name=$(basename "$entry")
    dst="$SHADOW_AGENT_DIR/$name"
    # Skip if destination already exists (settings.json was written above)
    [ -e "$dst" ] && continue
    ln -sfn "$entry" "$dst"
done

# extensions/: create a real writable dir in the shadow (not a symlink to
# the host) so the entrypoint can write sandbox-specific symlinks without
# touching the host's ~/.pi/agent/extensions/.
EXT_DIR="$SHADOW_AGENT_DIR/extensions"
# Remove catchall symlink if it exists, then create real dir
if [ -L "$EXT_DIR" ]; then rm "$EXT_DIR"; fi
mkdir -p "$EXT_DIR"

# ---------------------------------------------------------------------------
# Self-modification support:
# If SANDBOX_SELF_MODIFY=1, the sandbox source is mounted at
# $HOME/.sandbox-source. Symlink any skills from there into the shadow
# agent's skills/ dir for auto-discovery.
# ---------------------------------------------------------------------------
SANDBOX_SRC="$HOME/.sandbox-source"
if [[ "${SANDBOX_SELF_MODIFY:-0}" == "1" && -d "$SANDBOX_SRC/skills" ]]; then
    SKILL_DIR="$SHADOW_AGENT_DIR/skills"
    # skills/ is currently a symlink to the host dir (from the catchall);
    # replace it with a real dir that contains symlinks to both the host
    # skills and the sandbox source skills.
    HOST_SKILLS=$(readlink -f "$SKILL_DIR")
    rm "$SKILL_DIR"
    mkdir -p "$SKILL_DIR"
    # Re-symlink host skills into the new real dir
    if [ -d "$HOST_SKILLS" ]; then
        for skill in "$HOST_SKILLS"/*/; do
            [ -d "$skill" ] || continue
            name=$(basename "$skill")
            ln -sfn "$skill" "$SKILL_DIR/$name"
        done
    fi
    # Symlink sandbox source skills on top
    for skill in "$SANDBOX_SRC/skills"/*/; do
        [ -d "$skill" ] || continue
        name=$(basename "$skill")
        ln -sfn "$SANDBOX_SRC/skills/$name" "$SKILL_DIR/$name"
    done
fi

# ---------------------------------------------------------------------------
# Extension enablement:
# pi-sandbox sets PI_ENABLED_EXTENSIONS (comma-separated) based on user flags.
# We run pi with -ne (disable auto-discovery) and -e <path> for each enabled
# extension. This gives explicit control over which sandbox extensions are loaded.
#
# Available extensions are symlinked in $HOME/.pi-sandbox/pi-extensions/<name>.
# The entrypoint resolves each enabled name to its path and builds -e flags.
#
# If the container command is NOT pi (e.g., "bash"), we skip extension injection
# and exec the command as-is.
# ---------------------------------------------------------------------------

PI_EXT_DIR="$HOME/.pi-sandbox/pi-extensions"

# ---------------------------------------------------------------------------
# Point pi at the shadow agent dir instead of ~/.pi/agent/.
# ---------------------------------------------------------------------------
export PI_CODING_AGENT_DIR="$SHADOW_AGENT_DIR"

# ---------------------------------------------------------------------------
# SearXNG URL: if passed via PI_SEARXNG_URL from the launch script, export
# it as SEARXNG_URL for the searxng-suite extension to pick up.
# If not set, fall back to the extension default (http://localhost:8888).
# ---------------------------------------------------------------------------
if [ -n "${PI_SEARXNG_URL:-}" ]; then
    export SEARXNG_URL="$PI_SEARXNG_URL"
fi

# ---------------------------------------------------------------------------
# Ollama host-gateway workaround:
#
# When running inside a podman container on the same host as
# ollama.home.trprince.com, DNS may resolve to the container's own IP
# (due to bridged networking) or to an unreachable address. The host IS
# reachable via host.containers.internal, so we add a hosts entry mapping
# the ollama hostname to that IP.
#
# PI_OLLAMA_HOST_GATEWAY is set by the pi-sandbox launch script when it
# detects that ollama.home.trprince.com resolves to a local IP on the host.
# ---------------------------------------------------------------------------
if [ -n "${PI_OLLAMA_HOST_GATEWAY:-}" ]; then
    HOST_IP=$(getent hosts host.containers.internal | awk '{print $1}')
    if [ -n "$HOST_IP" ]; then
        # Passwordless sudo is configured for the sandbox user
        sudo sh -c "echo '$HOST_IP ollama.home.trprince.com' >> /etc/hosts" 2>/dev/null || \
            echo "Warning: failed to add hosts entry for ollama.home.trprince.com" >&2
    fi
fi

# Decide whether to inject extension flags into pi, or exec as-is.
# - No args (default CMD "pi")        → inject
# - First arg is "pi"                 → inject, shift past "pi"
# - First arg starts with "-"         → inject (treat as pi flags)
# - Anything else (e.g., "bash")     → exec as-is
if [ $# -eq 0 ] || [ "$1" = "pi" ] || [ "${1#-}" != "$1" ]; then
    # Build the pi command line: pi -ne -e <ext1> [-e <ext2>] ... [user-args]
    PI_ARGS=(-ne)

    IFS=',' read -ra EXT_NAMES <<< "${PI_ENABLED_EXTENSIONS:-}"
    for name in "${EXT_NAMES[@]}"; do
        ext_path="$PI_EXT_DIR/$name"
        if [ -d "$ext_path" ]; then
            PI_ARGS+=(-e "$ext_path")
        else
            echo "Warning: enabled extension '$name' not found at $ext_path" >&2
        fi
    done

    # Collect original args (skip leading "pi" if present)
    if [ $# -gt 0 ] && [ "$1" = "pi" ]; then
        shift
    fi

    exec pi "${PI_ARGS[@]}" "$@"
else
    # Not a pi command (e.g., bash, sh, node) — exec directly
    exec "$@"
fi
