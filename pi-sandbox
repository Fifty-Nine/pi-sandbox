#!/usr/bin/env bash
set -euo pipefail

IMAGE=pi-sandbox

# Detect the sandbox username from the image label (set during build).
# Falls back to "agent" if the image doesn't exist or the label is missing.
SANDBOX_USER=$(podman image inspect --format '{{index .Labels "sandbox.user"}}' "$IMAGE" 2>/dev/null) || true
if [[ -z "$SANDBOX_USER" || "$SANDBOX_USER" == *"<no value>"* ]]; then
    SANDBOX_USER=agent
fi

RW=false
SELF_MODIFY=false
NO_MOUNT=false
TMUX_MODE=false
TMUX_SOCKET=""
TMUX_SSH_HOST=""
SSH_MODE=false
ACLI_MODE=false
NO_ASK_USER=false
NO_SEARXNG=false
NO_PIIGNORE=false
MASK_PATHS=()

# -------------------------------------------------------------------
# Extension enablement: which pi extensions to load via -e.
# pi-ask-user and pi-searxng are enabled by default; disable with --no-ask-user / --no-searxng.
# pi-tmux-debug is enabled by --tmux or --tmux-ssh.
# To add a new extension: add a flag below that appends to
# ENABLED_EXTENSIONS, and add the flag to --help.
# -------------------------------------------------------------------
ENABLED_EXTENSIONS=(pi-ask-user pi-searxng)

while [[ $# -gt 0 ]]; do
    case "$1" in
        -w|--read-write) RW=true; shift ;;
        -s|--self-modify) SELF_MODIFY=true; shift ;;
        -S|--ssh) SSH_MODE=true; shift ;;
        --acli) ACLI_MODE=true; shift ;;
        -x|--no-mount) NO_MOUNT=true; shift ;;
        --tmux)
            TMUX_MODE=true
            ENABLED_EXTENSIONS+=(pi-tmux-debug)
            if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                TMUX_SOCKET="$(readlink -f $2)"
                shift 2
            else
                # Auto-detect: extract socket path from $TMUX or use default
                if [[ -n "${TMUX:-}" ]]; then
                    TMUX_SOCKET="${TMUX%%,*}"
                else
                    TMUX_SOCKET="/tmp/tmux-$(id -u)/default"
                fi
                shift
            fi
            ;;
        --tmux-ssh)
            if [[ $# -lt 2 ]]; then
                echo "Error: --tmux-ssh requires a hostname" >&2; exit 1
            fi
            TMUX_SSH_HOST="$2"
            ENABLED_EXTENSIONS+=(pi-tmux-debug)
            shift 2
            ;;
        --mask)
            if [[ $# -lt 2 ]]; then
                echo "Error: --mask requires a path argument" >&2; exit 1
            fi
            MASK_PATHS+=("$2")
            shift 2
            ;;
        --no-piignore)
            NO_PIIGNORE=true; shift ;;
        --no-ask-user)
            NO_ASK_USER=true; shift ;;
        --no-searxng)
            NO_SEARXNG=true; shift ;;
        --) shift; break ;;
        -h|--help)
            echo "Usage: $(basename "$0") [OPTIONS] [--] [PI-ARGS...] | [COMMAND...]"
            echo ""
            echo "Launch the pi-sandbox Podman container."
            echo ""
            echo "By default the container runs 'pi -ne -e pi-ask-user -e pi-searxng'. Extensions are"
            echo "disabled unless explicitly enabled via the flags below."
            echo ""
            echo "Options:"
            echo "  -w, --read-write    Mount the working directory read-write (default: read-only)"
            echo "  -x, --no-mount     Do not mount the working directory at all; the agent works"
            echo "                      from /home/<username> (read-write) instead"
            echo "  -S, --ssh           Forward the host SSH agent and mount ~/.ssh read-only so the"
            echo "                      agent can connect to remote hosts via SSH"
            echo "      --acli          Mount ~/.config/acli and forward D-Bus session bus so the"
            echo "                      agent can use the Atlassian CLI (acli) with Jira auth"
            echo "  -s, --self-modify   Mount the sandbox source directory read-write so the agent"
            echo "                      can modify the sandbox itself (Dockerfile, entrypoint, etc.)"
            echo "  --tmux [SOCKET]     Mount a tmux socket and enable the pi-tmux-debug extension."
            echo "                      SOCKET defaults to the current tmux session's socket."
            echo "  --tmux-ssh HOST    Enable SSH tmux mode and the pi-tmux-debug extension:"
            echo "                      proxy tmux commands to HOST over SSH."
            echo "                      Requires -S/--ssh for SSH agent forwarding."
            echo "  --mask PATH        Mask a directory from the agent by overlaying an empty"
            echo "                      read-only mount. PATH is relative to the working directory."
            echo "                      May be specified multiple times. Masked dirs appear empty"
            echo "                      inside the container with no host impact."
            echo "  --no-piignore      Do not read .piignore even if it exists in the working dir"
            echo "  --no-ask-user      Disable the pi-ask-user extension (enabled by default)"
            echo "  --no-searxng       Disable the pi-searxng extension (enabled by default)"
            echo "  --                  End of options; remaining args are passed to pi"
            echo "                      (or used as the container command if not a pi flag)"
            echo ""
            echo "After --, if the first argument starts with '-' or is 'pi', it is treated as"
            echo "a pi argument. Otherwise it replaces the container command entirely."
            echo ""
            echo ""
            echo "Masking:"
            echo "  Directories listed in .piignore (in the working directory) are automatically"
            echo "  masked from the agent — they appear as empty, read-only directories inside the"
            echo "  container. This has no impact on the host filesystem. Use --no-piignore to"
            echo "  skip this. Additional directories can be masked with --mask."
            echo ""
            echo "  The .piignore format is one path per line (relative to working directory)."
            echo "  Blank lines and lines starting with # are comments. Paths ending with / match"
            echo "  directories. Glob patterns (* and **) are supported."
            echo ""
            echo "Examples:"
            echo "  pi-sandbox                      # pi -ne -e pi-ask-user -e pi-searxng"
            echo "  pi-sandbox --tmux               # pi -ne -e pi-ask-user -e pi-searxng -e pi-tmux-debug"
            echo "  pi-sandbox --no-ask-user        # pi -ne -e pi-searxng"
            echo "  pi-sandbox --mask secrets/     # also mask the secrets/ directory"
            echo "  pi-sandbox --no-piignore       # skip .piignore even if it exists"
            echo "  pi-sandbox -- --resume          # pi -ne -e pi-ask-user -e pi-searxng --resume"
            echo "  pi-sandbox -- bash              # bash (not pi)"
            exit 0
            ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *)  break ;;            # first non-flag is the start of the command
    esac
done

# Transform host paths to container paths:
#   $HOME/.pi          -> /home/<SANDBOX_USER>/.pi
#   $PWD (under $HOME) -> /home/<SANDBOX_USER>/<relative-path>
CONTAINER_HOME=/home/$SANDBOX_USER

DOCKER_ARGS=(
    --mount "type=bind,source=$HOME/.pi,target=$CONTAINER_HOME/.pi"
)

if $NO_MOUNT; then
    # No CWD mount — agent works from /home/$SANDBOX_USER (read-write by default)
    AGENT_PWD=$CONTAINER_HOME
else
    AGENT_PWD="${PWD/#$HOME/$CONTAINER_HOME}"
    if $RW; then
        PWD_MOUNT="type=bind,source=$PWD,target=$AGENT_PWD"
    else
        PWD_MOUNT="type=bind,source=$PWD,target=$AGENT_PWD,readonly"
    fi
    DOCKER_ARGS+=(
        --mount "$PWD_MOUNT"
    )
fi

DOCKER_ARGS+=(
    -w "$AGENT_PWD"
)

# Self-modify: mount the sandbox source directory read-write
if $SELF_MODIFY; then
    SANDBOX_SOURCE_DIR="$(cd "$(dirname "$0")" && pwd)"
    DOCKER_ARGS+=(
        --mount "type=bind,source=$SANDBOX_SOURCE_DIR,target=$CONTAINER_HOME/.sandbox-source"
        --env SANDBOX_SELF_MODIFY=1
        --env SANDBOX_SOURCE_DIR=$CONTAINER_HOME/.sandbox-source
    )
fi

# Tmux debug mode: mount the tmux socket directory and set env vars
if $TMUX_MODE; then
    if [[ ! -S "$TMUX_SOCKET" ]]; then
        echo "Error: tmux socket not found at $TMUX_SOCKET" >&2
        echo "Make sure you are inside a tmux session, or provide the socket path: --tmux /path/to/socket" >&2
        exit 1
    fi
    TMUX_SOCKET_DIR=$(dirname "$TMUX_SOCKET")
    TMUX_MOUNTED_SOCKET_PATH=/tmux-socket-dir/$(basename "$TMUX_SOCKET")
    DOCKER_ARGS+=(
        --mount "type=bind,source=$TMUX_SOCKET_DIR,target=/tmux-socket-dir"
        --env TMUX_SOCKET_PATH=$TMUX_MOUNTED_SOCKET_PATH
        --env TMUX_DEBUG_MODE=1
    )
fi

# Build PI_ENABLED_EXTENSIONS from the accumulated list.
# --no-ask-user / --no-searxng remove individual defaults.
for REMOVE_EXT in $([[ "$NO_ASK_USER" == true ]] && echo pi-ask-user) $([[ "$NO_SEARXNG" == true ]] && echo pi-searxng); do
    FILTERED=()
    for ext in "${ENABLED_EXTENSIONS[@]}"; do
        if [ "$ext" != "$REMOVE_EXT" ]; then
            FILTERED+=("$ext")
        fi
    done
    ENABLED_EXTENSIONS=("${FILTERED[@]}")
done
PI_ENABLED_EXTENSIONS=$(IFS=,; echo "${ENABLED_EXTENSIONS[*]}")

DOCKER_ARGS+=(
    --env PI_ENABLED_EXTENSIONS=$PI_ENABLED_EXTENSIONS
)

if $SSH_MODE; then
    if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
        echo "Error: SSH_AUTH_SOCK is not set. Is ssh-agent running?" >&2
        exit 1
    fi
    if [[ ! -S "$SSH_AUTH_SOCK" ]]; then
        echo "Error: SSH_AUTH_SOCK ($SSH_AUTH_SOCK) does not exist or is not a socket" >&2
        exit 1
    fi
    SSH_AUTH_SOCK_REAL="$(readlink -f "$SSH_AUTH_SOCK")"
    SSH_AUTH_SOCK_DIR="$(dirname "$SSH_AUTH_SOCK_REAL")"
    SSH_AUTH_SOCK_BASE="$(basename "$SSH_AUTH_SOCK_REAL")"
    SSH_MOUNTED_SOCK="/ssh-agent-socket/$SSH_AUTH_SOCK_BASE"
    DOCKER_ARGS+=(
        --mount "type=bind,source=$SSH_AUTH_SOCK_DIR,target=/ssh-agent-socket"
        --env SSH_AUTH_SOCK=$SSH_MOUNTED_SOCK
        --mount "type=bind,source=$HOME/.ssh,target=$CONTAINER_HOME/.ssh,readonly"
    )
fi

# ACLI mode: mount ~/.config/acli read-only and forward the D-Bus session bus
# so acli can retrieve auth tokens from the host's keyring (Secret Service).
if $ACLI_MODE; then
    ACLI_CONFIG_DIR="$HOME/.config/acli"
    if [[ ! -d "$ACLI_CONFIG_DIR" ]]; then
        echo "Error: --acli requires ~/.config/acli to exist on the host." >&2
        echo "       Run 'acli auth login' on the host first to create it." >&2
        exit 1
    fi
    DOCKER_ARGS+=(
        --mount "type=bind,source=$ACLI_CONFIG_DIR,target=$CONTAINER_HOME/.config/acli,readonly"
    )
    # Forward D-Bus session bus so acli can reach the host keyring.
    # acli stores auth tokens (both OAuth and API token) in the OS keyring
    # via D-Bus Secret Service; the config files only hold metadata.
    DBUS_SESSION_DIR="/run/user/$(id -u)"
    if [[ -S "$DBUS_SESSION_DIR/bus" ]]; then
        # Mount at the same path inside the container so acli finds the
        # socket at its expected location. With --userns=keep-id the
        # container UID matches the host, so /run/user/<uid> is correct
        # on both sides. Also set DBUS_SESSION_BUS_ADDRESS as a fallback
        # in case the container lacks an XDG runtime directory setup.
        DOCKER_ARGS+=(
            --mount "type=bind,source=$DBUS_SESSION_DIR,target=$DBUS_SESSION_DIR"
            --env "DBUS_SESSION_BUS_ADDRESS=unix:path=$DBUS_SESSION_DIR/bus"
        )
    else
        echo "Warning: D-Bus session bus not found at $DBUS_SESSION_DIR/bus." >&2
        echo "         acli auth may fail without access to the host keyring." >&2
        echo "         Ensure you are running in a desktop session (graphical login or systemd --user)." >&2
    fi
fi

# Tmux SSH mode: set env var for the tmux tool to proxy over SSH
if [[ -n "$TMUX_SSH_HOST" ]]; then
    if $TMUX_MODE; then
        echo "Error: --tmux and --tmux-ssh are mutually exclusive. Use one or the other." >&2
        exit 1
    fi
    DOCKER_ARGS+=(
        --env TMUX_SSH_HOST=$TMUX_SSH_HOST
    )
fi

if [[ -d "/home/${SANDBOX_USER}/.keys" ]]; then
   DOCKER_ARGS+=(
      --mount "type=bind,source=/home/${SANDBOX_USER}/.keys,target=/home/${SANDBOX_USER}/.keys,readonly"
   )
fi

# -------------------------------------------------------------------
# Directory masking: overlay empty read-only bind mounts on top of
# paths that should be hidden from the agent. This has zero impact on
# the host filesystem — the masking is purely inside the container's
# mount namespace.
#
# We use bind mounts from a temporary empty directory instead of tmpfs,
# because Podman processes --tmpfs mounts before --mount type=bind
# mounts regardless of command-line order. This means a tmpfs overlay
# on a subdirectory of a bind mount (like the CWD) would be silently
# overridden by the bind mount. Using bind mounts for masking ensures
# they are applied in command-line order, after the CWD bind mount.
#
# Sources of mask paths:
#   1. --mask PATH flags (may be specified multiple times)
#   2. .piignore file in the working directory (one path per line,
#      comments with #, glob patterns with * and **)
#
# Each mask path is translated from host path to container path
# (replacing $HOME with $CONTAINER_HOME) and overlaid with a read-only
# bind mount from a temporary empty directory.
# -------------------------------------------------------------------
CONTAINER_MASK_PATHS=()

# Translate explicit --mask paths to container paths
for mask_path in ${MASK_PATHS[0]+"${MASK_PATHS[@]}"}; do
    # Resolve relative to CWD
    if [[ "$mask_path" = /* ]]; then
        abs_mask="$mask_path"
    else
        abs_mask="$PWD/$mask_path"
    fi
    # Normalize (remove trailing slash, resolve . and ..)
    abs_mask="$(cd "$(dirname "$abs_mask")" 2>/dev/null && pwd)/$(basename "$abs_mask")" 2>/dev/null || abs_mask="$PWD/$mask_path"
    # Translate to container path
    container_mask="${abs_mask/#$HOME/$CONTAINER_HOME}"
    CONTAINER_MASK_PATHS+=("$container_mask")
done

# Read .piignore if present (and not disabled)
if ! $NO_PIIGNORE && ! $NO_MOUNT && [[ -f "$PWD/.piignore" ]]; then
    # Enable globstar for ** patterns and nullglob for unmatched patterns
    prev_globstar=$(shopt -p globstar 2>/dev/null || true)
    prev_nullglob=$(shopt -p nullglob 2>/dev/null || true)
    shopt -s globstar nullglob
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Strip leading/trailing whitespace
        line="${line## }"
        line="${line%% }"
        # Skip empty lines and comments
        [[ -z "$line" || "$line" =~ ^# ]] && continue
        # Strip trailing slash for consistent matching
        line="${line%/}"
        # Expand glob patterns against the host filesystem
        # shellcheck disable=SC2086
        for match in $PWD/$line; do
            if [[ -d "$match" ]]; then
                # Translate matched directory to container path
                abs_match="$(cd "$match" && pwd)"
                container_match="${abs_match/#$HOME/$CONTAINER_HOME}"
                CONTAINER_MASK_PATHS+=("$container_match")
            fi
        done
    done < "$PWD/.piignore"
    # Restore previous globstar/nullglob settings
    eval "$prev_globstar"
    eval "$prev_nullglob"
fi

# Deduplicate mask paths
UNIQUE_MASK_PATHS=()
for path in "${CONTAINER_MASK_PATHS[@]}"; do
    skip=false
    for seen in "${UNIQUE_MASK_PATHS[@]}"; do
        if [[ "$path" == "$seen" ]]; then
            skip=true
            break
        fi
    done
    $skip || UNIQUE_MASK_PATHS+=("$path")
done

# Create a temporary empty directory for mask bind mounts.
# We use bind mounts from this empty directory instead of tmpfs because
# Podman applies --tmpfs mounts before --mount type=bind mounts regardless
# of command-line order, which would cause a tmpfs overlay to be silently
# overridden by the CWD bind mount. Bind mounts are applied in order.
if [[ ${#UNIQUE_MASK_PATHS[@]} -gt 0 ]]; then
    MASK_EMPTY_DIR=$(mktemp -d) || { echo "Error: Failed to create temp directory for masking" >&2; exit 1; }
    for mask_path in "${UNIQUE_MASK_PATHS[@]}"; do
        DOCKER_ARGS+=("--mount" "type=bind,source=$MASK_EMPTY_DIR,target=$mask_path,readonly")
    done
    # Run podman without exec so we can clean up the temp directory afterwards.
    # The bind mount is established at container creation time, so removing the
    # source directory after the container exits is safe — the data is no longer
    # needed by the container.
    podman run -it --rm --userns=keep-id "${DOCKER_ARGS[@]}" "$IMAGE" "$@"
    EXIT_STATUS=$?
    rm -rf "$MASK_EMPTY_DIR"
    exit $EXIT_STATUS
else
    exec podman run -it --rm --userns=keep-id "${DOCKER_ARGS[@]}" "$IMAGE" "$@"
fi
